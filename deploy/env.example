# Copie para .env na raiz do projeto e mantenha fora do Git (chmod 600 .env).
SHOP_DOMAIN=loja.exemplo.com
DB_PASSWORD=
JWT_SECRET=

# Configure as chaves live e o webhook no dia da ativacao Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://loja.exemplo.com/?checkout=success
STRIPE_CANCEL_URL=https://loja.exemplo.com/?checkout=cancelled

# Resend: crie uma chave de API e verifique o dominio remetente no painel.
# Opcional: origem HTTPS usada nos links de recuperacao; vazio usa STRIPE_SUCCESS_URL.
PASSWORD_RESET_URL=
RESEND_API_KEY=
EMAIL_FROM=
